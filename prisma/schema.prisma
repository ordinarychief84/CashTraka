// CashTraka — WhatsApp Sales & Cash Tracker + Property Manager
// Prisma schema. Provider is sqlite for easy local dev; swap to postgresql for prod.
// To deploy against Postgres:
//   1) Change `provider = "sqlite"` to `provider = "postgresql"` below.
//   2) Set DATABASE_URL to your Postgres connection string (see .env.postgres.example).
//   3) Run `npx prisma migrate deploy` (or `prisma migrate dev --name whatever` in dev).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- USER ----------

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  businessName   String?
  whatsappNumber String?
  receiptFooter  String?
  /// "seller" (default) or "property_manager"
  businessType   String    @default("seller")
  /// "free" | "business" | "business_plus" | "landlord" | "estate_manager"
  plan           String    @default("free")
  /// "USER" (default) or "ADMIN". Admins access /admin.
  role           String    @default("USER")
  /// Suspended users cannot log in.
  isSuspended    Boolean   @default(false)
  /// Soft-delete marker. Tax-relevant FKs are Restrict, so a hard
  /// delete on this user would fail. Set this instead. Nigerian FIRS
  /// requires 6-year retention on receipts/invoices/payments.
  deletedAt      DateTime?
  /// Timestamp of last successful login (for audit + analytics).
  lastLoginAt    DateTime?

  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  /// Address line shown on invoices.
  businessAddress String?
  /// URL of the seller's logo (uploaded via Cloudinary) — printed on receipts & invoices.
  logoUrl         String?

  /// Per-business receipt prefix. Defaults to "CT" → CT-00001. Editable in Settings.
  receiptPrefix String? @default("CT")

  /// Public storefront slug (used in /store/[slug]). Unique, kebab-case.
  slug           String? @unique
  /// Whether the public catalog is published. Slug must also be set.
  catalogEnabled Boolean @default(false)
  /// Optional headline shown above the catalog grid.
  catalogTagline String?

  /// ── Nigerian tax / FIRS compliance ────────────────────────────
  /// Tax Identification Number issued by FIRS. Required on tax invoices
  /// once the business is VAT-registered.
  tin            String?
  /// Whether the business is VAT-registered with FIRS. Mandatory for
  /// businesses with annual turnover > ₦25M; optional below that threshold.
  vatRegistered  Boolean @default(false)
  /// Default VAT rate (percent) applied when vatRegistered=true. Standard
  /// Nigerian rate is 7.5; some categories may use a different rate.
  vatRate        Float   @default(7.5)
  /// Merchant ID assigned by FIRS once the business onboards to MBS.
  /// Required by the real FIRS adapter; not used by NoopFIRSAdapter.
  firsMerchantId String?

  /// ── Invoice settings ──────────────────────────────────────────
  /// Default currency code (ISO-4217). NGN by default for Nigerian SMBs.
  defaultCurrency     String  @default("NGN")
  /// Per-business invoice number prefix. e.g. "INV" -> INV-00042.
  invoicePrefix       String? @default("INV")
  /// Per-business credit-note prefix. e.g. "CN" -> CN-00042.
  creditNotePrefix    String? @default("CN")
  /// Per-business offer/quote prefix. e.g. "OFF" -> OFF-00042.
  offerPrefix         String? @default("OFF")
  /// Per-business delivery-note prefix.
  deliveryNotePrefix  String? @default("DN")
  /// Per-business order-confirmation prefix.
  orderPrefix         String? @default("ORD")
  /// Whether tax (VAT) is enabled by default on new invoices. Mirrors
  /// vatRegistered for the common case but can be overridden per invoice.
  taxEnabled          Boolean @default(false)
  /// Free-form payment instructions printed on invoices ("Pay to bank X
  /// account 1234567890. Reference your invoice number.").
  paymentInstructions String?
  /// Hex accent color used on invoice PDFs and the public page.
  invoiceAccentColor  String? @default("#00B8E8")
  /// "simple" | "professional" | "compact" — chooses the PDF template.
  invoiceTemplate     String? @default("professional")

  /// ── Workflow defaults (per-user preferences inside an unlocked plan) ──
  /// Auto-submit invoices to FIRS on creation when plan allows + user opts in.
  firsAutoSubmit           Boolean @default(false)
  /// Default due date offset, in days, for new invoices. null = no default.
  defaultInvoiceDueDays    Int?
  /// Default payment terms text shown on every new invoice unless overridden.
  defaultPaymentTerms      String? @db.VarChar(120)
  /// Reminder cadence: OFF | FRIENDLY_3_DAYS | FRIENDLY_7_DAYS | OVERDUE_DAILY.
  invoiceReminderCadence   String  @default("OFF")
  /// Auto-archive receipts/PDFs older than N days. null = never.
  autoArchiveDays          Int?
  /// Default for new recurring rules: autoSend on.
  recurringAutoSendDefault Boolean @default(false)
  /// Auto-generate XML when submitting to FIRS.
  xmlGenerateOnFirs        Boolean @default(true)
  /// Retention hint shown on DocumentArchive (72 months = 6 years per Nigerian
  /// tax records best practice).
  documentRetentionMonths  Int     @default(72)

  /// Billing state. `plan` (above) is the *tier name*; these fields describe
  /// the subscription lifecycle around that tier.
  /// "free" | "trialing" | "active" | "past_due" | "cancelled"
  subscriptionStatus       String    @default("free")
  /// End of the 30-day trial, if we started one. null if never trialled.
  trialEndsAt              DateTime?
  /// End of the current paid period (renewal date, or cancelled-grace boundary).
  currentPeriodEnd         DateTime?
  /// Paystack identifiers (stored once on first successful charge).
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  /// The plan the user picked at checkout; cleared when the webhook confirms.
  pendingPlan              String?

  /// Personal-expense thresholds (naira). When the owner's personal spending
  /// in the current week / month crosses either number, the dashboard
  /// surfaces a warning banner. Both are optional — leave null to disable.
  personalBudgetWeekly  Int?
  personalBudgetMonthly Int?

  /// ── Service Check (customer feedback) preferences ─────────────
  /// Master switch. When false, no automatic feedback links are minted.
  autoSendFeedback         Boolean @default(false)
  /// Auto-create a feedback link after a receipt is generated.
  feedbackAfterReceipt     Boolean @default(true)
  /// Auto-create a feedback link after a payment is confirmed.
  feedbackAfterPayment     Boolean @default(true)
  /// Auto-create a feedback link after an invoice is fully paid.
  feedbackAfterInvoicePaid Boolean @default(true)
  /// Days the public feedback link stays valid. null = never expire.
  feedbackLinkExpiryDays   Int?    @default(14)
  /// Optional WhatsApp message template. Supports {name} and {url} placeholders.
  feedbackMessageTemplate  String?

  /// ── Platform fee opt-in ───────────────────────────────────────
  /// When true, every Paystack invoice payment confirmed for this seller is
  /// annotated with a 1% platform fee (capped at ₦5,000) recorded as audit
  /// metadata on the Payment row. v1 is informational only — no funds are
  /// split, the seller remits manually. Future versions will plug into
  /// Paystack subaccount split.
  platformFeeOptIn Boolean @default(false)

  onboardingCompleted Boolean   @default(false)
  /// Whether the user has verified their email via OTP.
  emailVerified       Boolean   @default(false)
  /// Timestamp when user accepted Terms & Privacy Policy.
  termsAcceptedAt     DateTime?
  /// Timestamp when the delayed welcome email was sent (30 min after signup).
  welcomeEmailSentAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customers           Customer[]
  payments            Payment[]
  debts               Debt[]
  products            Product[]
  expenses            Expense[]
  templates           MessageTemplate[]
  fraudReports        FraudReport[]
  invoices            Invoice[]
  reminderSchedules   ReminderSchedule[]
  customRoles         CustomRole[]
  staffMembers        StaffMember[]
  attendance          Attendance[]
  staffPayments       StaffPayment[]
  tasks               Task[]
  checklists          Checklist[]
  checklistRuns       ChecklistRun[]
  sales               Sale[]
  receipts            Receipt[]
  adminNotesAuthored  AdminNote[]            @relation("AdminNoteAuthor")
  adminNotesReceived  AdminNote[]            @relation("AdminNoteTarget")
  paymentAttempts     PaymentAttempt[]
  passwordResetTokens PasswordResetToken[]
  supportTickets      SupportTicket[]        @relation("UserTickets")
  assignedTickets     SupportTicket[]        @relation("AssignedTickets")
  ticketReplies       TicketReply[]
  notifications       Notification[]
  refunds             Refund[]               @relation("UserRefunds")
  processedRefunds    Refund[]               @relation("ProcessedRefunds")
  auditLogs           AuditLog[]             @relation("AuditLogAdmin")
  paymentRequests     PaymentRequest[]
  emailVerifications  EmailVerification[]
  reminderRules       ReminderRule[]
  reminderLogs        ReminderLog[]
  customerNotes       CustomerNote[]
  createdAdminStaff   AdminStaff[]           @relation("AdminStaffCreator")
  promisesToPay       PromiseToPay[]
  installmentPlans    InstallmentPlan[]
  catalogEvents       CatalogEvent[]
  albums              Album[]
  invoiceReminders    InvoiceReminder[]
  creditNotes         CreditNote[]
  recurringInvoices   RecurringInvoiceRule[]
  deliveryNotes       DeliveryNote[]
  offers              Offer[]
  orderConfirmations  OrderConfirmation[]
  documentArchives    DocumentArchive[]
  documentAuditLogs   DocumentAuditLog[]
  feedbacks           Feedback[]
  vatReturns          VatReturn[]
  linkedBankAccounts  LinkedBankAccount[]
  virtualAccounts     VirtualAccount[]
  override            UserOverride?

  // ── Operational Planning (small-batch ops) ────────────────────
  suppliers        Supplier[]
  rawMaterials     RawMaterial[]
  recipes          Recipe[]
  customerOrders   CustomerOrder[]
  productionOrders ProductionOrder[]
  productionTemplates ProductionTemplate[]
  purchaseOrders   PurchaseOrder[]
  stockMovements   StockMovement[]
  orderSubscriptions CustomerOrderSubscription[]
  certificates     Certificate[]
  shortageAlerts   MaterialShortageAlert[]

  @@index([role])
  @@index([businessType])
  @@index([isSuspended])
  @@index([lastLoginAt])
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- CORE: customers, payments, debts ----------

model Customer {
  id               String   @id @default(cuid())
  userId           String
  name             String
  phone            String
  totalPaid        Int      @default(0)
  totalOwed        Int      @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration. See docs/kobo-migration-plan.md.
  totalPaidKobo    Int      @default(0)
  totalOwedKobo    Int      @default(0)
  transactionCount Int      @default(0)
  lastActivityAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Phase 4 — behavior tagging: FAST_PAYER | LATE_PAYER | DORMANT | HIGH_VALUE | NEW
  behaviorTag    String?
  /// Average number of days to pay after receiving a request
  avgPayDays     Float?
  /// Number of times this customer has been reminded
  totalReminders Int       @default(0)
  /// Last time a reminder was sent for any debt
  lastRemindedAt DateTime?

  /// Free-text notes about this customer (e.g. preferences, history)
  notes String?
  /// Comma-separated custom tags for grouping/filtering
  tags  String?
  /// Maximum outstanding debt allowed for this customer (kobo). null = no limit.
  /// Enforced server-side in debts.service when creating a new debt + surfaced
  /// in the UI as a "near limit" / "over limit" warning chip.
  creditLimitKobo Int?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  debts              Debt[]
  invoices           Invoice[]
  paymentRequests    PaymentRequest[]
  customerNotes      CustomerNote[]
  promisesToPay      PromiseToPay[]
  deliveryNotes      DeliveryNote[]
  offers             Offer[]
  orderConfirmations OrderConfirmation[]
  feedbacks          Feedback[]
  customerOrders     CustomerOrder[]
  orderSubscriptions CustomerOrderSubscription[]

  @@unique([userId, phone])
  @@index([userId])
  @@index([phone])
  @@index([userId, behaviorTag])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  note       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
}

model Payment {
  id                   String   @id @default(cuid())
  userId               String
  customerId           String
  customerNameSnapshot String
  phoneSnapshot        String
  amount               Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo           Int      @default(0)
  status               String   @default("PAID")
  createdAt            DateTime @default(now())

  referenceCode       String?   @unique
  verified            Boolean   @default(false)
  verifiedAt          DateTime?
  verificationMethod  String?
  bankAlertText       String?
  bankAlertSenderName String?
  bankAlertBank       String?
  /// How the bank-alert payment was created.
  /// "AUTO"            — parser extracted amount + sender from the SMS.
  /// "PARTIAL"         — parser found amount, owner typed the sender in.
  /// "MANUAL_ENTERED"  — parser failed; owner typed every field by hand.
  parseSource         String    @default("AUTO")
  claimedAt           DateTime?

  /// If this payment was created from an invoice, link back.
  invoiceId String?

  /// Whether a receipt was auto-sent after verification.
  receiptSentAt DateTime?

  /// Provider payment fields (for auto-confirmed payments via webhook)
  externalRef            String?
  provider               String?
  providerTransactionId  String?
  confirmedAutomatically Boolean   @default(false)
  confirmedAt            DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items     PaymentItem[]
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  feedbacks Feedback[]

  // Webhook idempotency: two simultaneous Paystack retries must not double-book.
  // Enforced as a partial unique index at the DB level (some manual-entry Payment
  // rows have NULL externalRef) via runtime DDL in src/app/api/migrate/route.ts.
  @@unique([userId, externalRef])
  @@index([userId, createdAt])
  @@index([userId, verified])
}

model PaymentItem {
  id            String  @id @default(cuid())
  paymentId     String
  productId     String?
  description   String
  unitPrice     Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  unitPriceKobo Int     @default(0)
  quantity      Int     @default(1)

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

model Debt {
  id                   String    @id @default(cuid())
  userId               String
  customerId           String
  customerNameSnapshot String
  phoneSnapshot        String
  amountOwed           Int
  amountPaid           Int       @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  amountOwedKobo       Int       @default(0)
  amountPaidKobo       Int       @default(0)
  dueDate              DateTime?
  status               String    @default("OPEN")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// Phase 2 — follow-up tracking
  reminderCount  Int       @default(0)
  lastRemindedAt DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminderSchedules ReminderSchedule[]
  reminderRules     ReminderRule[]

  @@index([userId, status])
}

// ---------- PRODUCTS ----------

model Product {
  id         String  @id @default(cuid())
  userId     String
  name       String
  price      Int
  cost       Int?
  /// Kobo siblings — Phase 3 of the kobo migration.
  priceKobo  Int     @default(0)
  costKobo   Int?
  stock      Int     @default(0)
  trackStock Boolean @default(true)
  lowStockAt Int     @default(3)
  /// Buffer below `lowStockAt`. When stock drops below this the alert is
  /// upgraded from "low" → "critical".
  safetyStock Int?
  note       String?
  archived   Boolean @default(false)
  /// "ACTIVE" | "INACTIVE" | "DISCONTINUED" — operational status separate
  /// from `archived` (legacy delete flag). Default ACTIVE; new code reads
  /// this, legacy code keeps reading `archived`.
  status     String  @default("ACTIVE")

  /// Free-form category for filter UI (e.g. "Soap", "Cake", "Furniture").
  category    String?
  /// Unit of sale label (e.g. "bottle", "pack", "kg", "metre"). Display only.
  unitOfSale  String?
  /// Minimum quantity a single order line can buy (bulk-only items).
  minimumSellingQuantity Int?
  /// Suggested batch size for production-planning UI.
  defaultBatchSize Int?
  /// Typical lead time from production start → ready, used by the order form.
  defaultProductionLeadTimeDays Int?
  /// Flag whether this product can be produced in-house (vs resold).
  canBeProduced Boolean @default(false)
  /// Per-unit batch tracking — when true, the production form must collect
  /// a batch number before completing.
  batchTracking Boolean @default(false)
  /// When true, every unit carries an expiry stamped at production complete.
  expiryTracking Boolean @default(false)
  /// Optional barcode value (EAN/UPC/QR) for label printing.
  barcodeValue   String?

  /// Catalog (Sell) fields.
  /// Up to 8 Uploadcare image URLs (validator enforces the cap).
  images        String[] @default([])
  /// Optional SKU shown on the catalog detail page.
  sku           String?
  /// Public-facing description shown on /store/[slug]/[productId].
  description   String?
  /// When true, the product appears on /store/[slug] (requires User.catalogEnabled too).
  isPublished   Boolean  @default(false)
  /// "AVAILABLE" | "LOW_STOCK" | "SOLD_OUT" — manual override used only when trackStock=false.
  catalogStatus String   @default("AVAILABLE")

  /// NAFDAC certification number for the product (Nigerian food/cosmetic
  /// regulator). Printed on labels + customer-facing receipts when set.
  nafdacNumber  String?
  /// Default shelf life in days. When a ProductionOrder is started for
  /// this product, the run's `expiresAt` is auto-set to
  /// `startedAt + shelfLifeDays` if the user didn't pick a date.
  shelfLifeDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                PaymentItem[]
  invoiceItems         InvoiceItem[]
  saleItems            SaleItem[]
  catalogEvents        CatalogEvent[]
  albumLinks           AlbumProduct[]
  deliveryNoteItems    DeliveryNoteItem[]
  offerItems           OfferItem[]
  recipe               Recipe?
  customerOrderItems   CustomerOrderItem[]
  productionOrderItems ProductionOrderItem[]
  productionTemplateItems ProductionTemplateItem[]
  certificates         Certificate[]

  @@index([userId, archived])
  @@index([userId, isPublished])
  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, canBeProduced])
}

// ---------- SALES (Walk-in POS) ----------

model Sale {
  id            String   @id @default(cuid())
  userId        String
  /// Auto-incrementing receipt number like "SLE-00042"
  saleNumber    String   @unique
  customerName  String?
  customerPhone String?
  customerEmail String?
  subtotal      Int      @default(0)
  tax           Int      @default(0)
  discount      Int      @default(0)
  total         Int      @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  subtotalKobo  Int      @default(0)
  taxKobo       Int      @default(0)
  discountKobo  Int      @default(0)
  totalKobo     Int      @default(0)
  /// "CASH" | "TRANSFER" | "POS" | "CARD"
  paymentMethod String   @default("CASH")
  note          String?
  /// Exact time the sale was recorded
  soldAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items SaleItem[]

  @@index([userId, soldAt])
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  productId     String?
  description   String
  unitPrice     Int
  quantity      Int     @default(1)
  total         Int     @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  unitPriceKobo Int     @default(0)
  totalKobo     Int     @default(0)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

// ---------- EXPENSES ----------

model Expense {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  /// Kobo sibling — Phase 3 of the kobo migration. (vatPaid below is already kobo.)
  amountKobo    Int      @default(0)
  category      String
  note          String?
  /// "business" (default) or "personal"
  kind          String   @default("business")
  /// Payment method: cash, transfer, card, pos, other
  paymentMethod String?
  /// Vendor / payee name
  vendor        String?
  /// Whether this is a recurring expense
  isRecurring   Boolean  @default(false)
  /// Receipt or reference number
  receiptRef    String?
  /// Whether this expense is tax-deductible (business only)
  taxDeductible Boolean  @default(false)
  /// Input VAT in kobo, the seller-paid VAT they can claim back on this expense.
  /// Used by the VAT-return generator (Tax+ tier) to compute net VAT due.
  vatPaid       Int      @default(0)
  incurredOn    DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, incurredOn])
  @@index([userId, kind, incurredOn])
}

// ---------- MESSAGING ----------

model MessageTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- FRAUD ----------

model FraudReport {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([phone])
}

// ---------- INVOICES ----------

/// A formal invoice the seller can generate and share before or after payment.
/// Public at /invoice/[invoiceNumber].
model Invoice {
  id               String    @id @default(cuid())
  userId           String
  customerId       String?
  /// Human-readable number like "INV-00042".
  invoiceNumber    String    @unique
  customerName     String
  customerPhone    String
  customerEmail    String?
  /// Status pipeline:
  ///   DRAFT  -> SENT   when /send is invoked
  ///   SENT   -> VIEWED when the public page is opened
  ///   any    -> PARTIALLY_PAID / PAID when payments arrive
  ///   any    -> OVERDUE when dueDate passes and not fully paid
  ///   any    -> CANCELLED / CREDITED via credit-note flow
  status           String    @default("DRAFT")
  subtotal         Int       @default(0)
  /// Optional flat-amount discount in the invoice currency (subtracted from
  /// subtotal before VAT). Percent discounts can be modeled as line-item
  /// edits to keep the math simple here.
  discount         Int       @default(0)
  tax              Int       @default(0)
  total            Int       @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  subtotalKobo     Int       @default(0)
  discountKobo     Int       @default(0)
  taxKobo          Int       @default(0)
  totalKobo        Int       @default(0)
  note             String?
  /// Free-text payment terms shown on the invoice (e.g. "Net 14",
  /// "Due on receipt"). Falls back to User.paymentInstructions when empty.
  paymentTerms     String?
  dueDate          DateTime?
  issuedAt         DateTime  @default(now())
  paidAt           DateTime?
  /// Cumulative amount paid against this invoice (across one or more
  /// PaymentRequest/Payment rows). Used to compute outstanding balance.
  amountPaid       Int       @default(0)
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountPaidKobo   Int       @default(0)
  /// Set the first time the public /invoice/[publicToken] page renders.
  viewedAt         DateTime?
  /// Set when /api/invoices/[id]/send fires. Used by the dashboard to
  /// distinguish issued-but-not-sent vs. issued-and-sent invoices.
  sentAt           DateTime?
  /// Non-guessable token that powers /invoice/[publicToken]. We rotate
  /// the model default to a cuid+random suffix so brute-force is impractical.
  publicToken      String?   @unique
  /// Internal XML export URL (not an official FIRS-schema submission;
  /// see invoice-xml.service.ts comments). Used by the "Download XML" button.
  xmlUrl           String?
  xmlGeneratedAt   DateTime?
  /// Optional electronic-submission status separate from firsStatus.
  /// "DRAFT" | "READY_FOR_SUBMISSION" | "SUBMITTED" | "FAILED" | "ACCEPTED" |
  /// "REJECTED" | "NOT_CONFIGURED"
  electronicStatus String?
  /// Optional link to a recurring rule that produced this invoice.
  recurringRuleId  String?

  /// 1:1 link back to the Payment that spawned this invoice (if generated from one).
  /// Used for idempotent generation from /api/payments/[id]/invoice.
  paymentId String? @unique

  /// ── Nigerian tax compliance fields ─────────────────────────────
  /// Buyer's TIN (required on B2B tax invoices when issuing under FIRS rules).
  buyerTin     String?
  /// Buyer's billing address.
  buyerAddress String?
  /// Was VAT applied to this invoice? Snapshot at issue time.
  vatApplied   Boolean @default(false)
  /// VAT rate (percent) at issue time. Snapshot from User.vatRate.
  vatRate      Float   @default(0)
  /// Currency code. Defaults to NGN. ISO-4217.
  currency     String  @default("NGN")

  /// ── FIRS MBS (Merchant Buyer Solution) submission state ────────
  /// Adapter is a Noop until FIRS_API_BASE_URL + FIRS_API_KEY are configured
  /// (see firs-invoice.service.ts).
  firsTransmissionRef String?
  /// Invoice Reference Number issued by FIRS on successful submission.
  /// Must be rendered on the invoice once received.
  firsIrn             String?
  /// Opaque QR code payload returned by FIRS. Rendered as a QR on the invoice.
  firsQrPayload       String?
  /// "PENDING" | "SUBMITTED" | "ACCEPTED" | "REJECTED" | "RETRYING" | "FAILED" | null
  firsStatus          String?
  firsLastError       String?
  firsRetryCount      Int       @default(0)
  firsSubmittedAt     DateTime?
  firsAcceptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       Payment[]
  reminders      InvoiceReminder[]
  creditNotes    CreditNote[]
  recurringRule  RecurringInvoiceRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  feedbacks      Feedback[]
  virtualAccount VirtualAccount?
  customerOrder  CustomerOrder?

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([recurringRuleId])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  productId     String?
  description   String
  unitPrice     Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  unitPriceKobo Int     @default(0)
  quantity      Int     @default(1)

  /// "GOODS" | "SERVICE". Required for FIRS classification.
  itemType  String  @default("GOODS")
  /// Harmonized System code (e.g., "8517.12"). Required for goods on tax invoices.
  hsCode    String?
  /// Whether this line is VAT-exempt (basic food, books, medical, etc.).
  vatExempt Boolean @default(false)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

/// Reminder sent (or scheduled) for an unpaid invoice. Manual reminders
/// fire from the invoice detail page; automated reminders are produced by
/// /api/cron/run-recurring-invoices when a rule schedules them.
model InvoiceReminder {
  id        String    @id @default(cuid())
  userId    String
  invoiceId String
  /// "FRIENDLY_REMINDER" | "OVERDUE_NOTICE" | "FINAL_NOTICE"
  type      String    @default("FRIENDLY_REMINDER")
  /// "EMAIL" | "WHATSAPP"
  channel   String
  /// The message body actually sent (or queued). Snapshot so we can
  /// audit what the customer received even if templates change later.
  message   String
  sentAt    DateTime?
  /// "QUEUED" | "SENT" | "FAILED"
  status    String    @default("QUEUED")
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([invoiceId, createdAt])
}

/// Credit note (a.k.a. cancellation invoice). Generated when a finalized
/// invoice is reversed in part or in whole. The original invoice flips
/// to CREDITED or CANCELLED depending on whether the credit-note total
/// equals the invoice total.
model CreditNote {
  id               String   @id @default(cuid())
  userId           String
  invoiceId        String
  creditNoteNumber String   @unique
  reason           String?
  subtotal         Int      @default(0)
  taxAmount        Int      @default(0)
  total            Int      @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  subtotalKobo     Int      @default(0)
  taxAmountKobo    Int      @default(0)
  totalKobo        Int      @default(0)
  pdfUrl           String?
  /// Non-guessable token if we ever expose a public credit-note page.
  publicToken      String?  @unique
  /// Tax+ two-person rule: id of the staff member who confirmed a credit
  /// note above the high-value threshold. Null when the actor was the
  /// owner or the note was below the threshold. Stored as a free-form
  /// string id (no relation) so the migration stays trivial.
  approvedById     String?
  createdAt        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([invoiceId])
}

/// Schedule that auto-creates invoices on a recurring cadence (rent,
/// retainers, monthly service fees). The cron at
/// /api/cron/run-recurring-invoices reads `nextRunAt` and produces an
/// invoice when due, then advances `nextRunAt` by `frequency`.
model RecurringInvoiceRule {
  id            String    @id @default(cuid())
  userId        String
  customerId    String?
  /// "WEEKLY" | "MONTHLY" | "QUARTERLY" | "YEARLY"
  frequency     String
  startDate     DateTime
  nextRunAt     DateTime
  endDate       DateTime?
  autoSend      Boolean   @default(false)
  /// "ACTIVE" | "PAUSED" | "CANCELLED"
  status        String    @default("ACTIVE")
  /// JSON snapshot of invoice fields (line items, currency, vat etc.).
  /// Stored as text to keep schema simple; service layer JSON.parses.
  templateData  String
  /// Number of invoices this rule has produced; useful for naming.
  runsCompleted Int       @default(0)
  lastRunAt     DateTime?
  lastRunError  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId, status])
  @@index([nextRunAt, status])
}

/// Goods-out tracking. A delivery note can be issued before payment
/// (e.g. when goods ship before invoicing) and converted into an invoice
/// later via /api/delivery-notes/[id]/convert-to-invoice.
model DeliveryNote {
  id                 String    @id @default(cuid())
  userId             String
  customerId         String?
  customerName       String
  customerPhone      String?
  customerAddress    String?
  deliveryNoteNumber String    @unique
  /// "DRAFT" | "ISSUED" | "DELIVERED" | "CONVERTED" | "CANCELLED"
  status             String    @default("DRAFT")
  deliveryDate       DateTime?
  notes              String?
  pdfUrl             String?
  /// When converted to an invoice, link to the resulting Invoice.
  convertedInvoiceId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    DeliveryNoteItem[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model DeliveryNoteItem {
  id             String  @id @default(cuid())
  deliveryNoteId String
  productId      String?
  description    String
  quantity       Int     @default(1)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([deliveryNoteId])
}

/// Quote / offer the seller can send before issuing an invoice. Convertible
/// to either an Invoice or an OrderConfirmation.
model Offer {
  id                           String    @id @default(cuid())
  userId                       String
  customerId                   String?
  customerName                 String
  customerPhone                String?
  customerEmail                String?
  offerNumber                  String    @unique
  /// "DRAFT" | "SENT" | "ACCEPTED" | "DECLINED" | "EXPIRED" | "CONVERTED"
  status                       String    @default("DRAFT")
  validUntil                   DateTime?
  subtotal                     Int       @default(0)
  taxAmount                    Int       @default(0)
  total                        Int       @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  subtotalKobo                 Int       @default(0)
  taxAmountKobo                Int       @default(0)
  totalKobo                    Int       @default(0)
  notes                        String?
  pdfUrl                       String?
  publicToken                  String?   @unique
  /// When converted, link to the produced Invoice or OrderConfirmation.
  convertedInvoiceId           String?   @unique
  convertedOrderConfirmationId String?   @unique
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              OfferItem[]
  orderConfirmations OrderConfirmation[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model OfferItem {
  id            String  @id @default(cuid())
  offerId       String
  productId     String?
  description   String
  unitPrice     Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  unitPriceKobo Int     @default(0)
  quantity      Int     @default(1)

  offer   Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([offerId])
}

/// Order confirmation (a.k.a. sales order) generated from an accepted Offer.
/// Snapshots the offer's items so price changes on the offer cannot
/// retroactively change the order.
model OrderConfirmation {
  id           String   @id @default(cuid())
  userId       String
  offerId      String?
  customerId   String?
  customerName String
  orderNumber  String   @unique
  /// "DRAFT" | "CONFIRMED" | "FULFILLED" | "CANCELLED"
  status       String   @default("CONFIRMED")
  total        Int      @default(0)
  /// Kobo sibling — Phase 3 of the kobo migration.
  totalKobo    Int      @default(0)
  notes        String?
  pdfUrl       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer          Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerOrders CustomerOrder[]

  @@index([userId, createdAt])
}

/// Document archive — one row per finalized document for retention and
/// search. Receipts/Invoices/CreditNotes/etc. write here on creation.
/// `retentionUntil` is a hint for soft-purge tooling; we do not auto-delete.
model DocumentArchive {
  id             String    @id @default(cuid())
  userId         String
  /// "RECEIPT" | "INVOICE" | "CREDIT_NOTE" | "DELIVERY_NOTE" | "OFFER" |
  /// "ORDER_CONFIRMATION"
  documentType   String
  /// FK-style reference to the originating record (Invoice.id, Receipt.id, ...).
  documentId     String
  /// Public number displayed to humans (INV-00042 etc.). Helps search.
  documentNumber String?
  pdfUrl         String?
  xmlUrl         String?
  /// "ACTIVE" | "ARCHIVED" | "PURGED"
  status         String    @default("ACTIVE")
  /// Optional soft-retention hint; UI surfaces a warning before this date.
  retentionUntil DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([documentType, documentId])
  @@index([userId, documentType, createdAt])
  @@index([userId, documentNumber])
}

/// Per-document audit log. Every state change (created, sent, viewed,
/// paid, cancelled, credited) writes a row. Distinct from the existing
/// admin-only `AuditLog` model.
model DocumentAuditLog {
  id         String   @id @default(cuid())
  userId     String
  /// Actor who triggered the action. Null when the system did it
  /// (e.g. webhook, cron).
  actorId    String?
  /// "INVOICE" | "RECEIPT" | "CREDIT_NOTE" | "DELIVERY_NOTE" | "OFFER" |
  /// "ORDER_CONFIRMATION" | "RECURRING_RULE"
  entityType String
  entityId   String
  /// e.g. "CREATED" | "SENT" | "VIEWED" | "PAID" | "CANCELLED" | "CREDITED" |
  /// "REMINDER_SENT" | "RECURRING_GENERATED" | "XML_GENERATED" | "FIRS_SUBMITTED"
  action     String
  /// Free-form JSON metadata as a string (kept as text for schema simplicity).
  metadata   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, entityType, entityId, createdAt])
  @@index([userId, action, createdAt])
}

// ---------- REMINDERS ----------

/// A scheduled reminder linked to a Debt. The system surfaces which reminders are
/// "due today" so the seller can one-tap send them all in WhatsApp.
model ReminderSchedule {
  id           String    @id @default(cuid())
  userId       String
  debtId       String
  /// "daily" | "every_3_days" | "weekly" | "custom"
  frequency    String    @default("weekly")
  /// Custom: number of days between reminders. Used when frequency=custom.
  intervalDays Int       @default(7)
  nextDueAt    DateTime
  lastSentAt   DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([userId, nextDueAt])
}

// ---------- TEAM, ATTENDANCE & PAYROLL ----------

model CustomRole {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  baseRole    String   @default("CASHIER")
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffMembers StaffMember[]

  @@unique([userId, name])
  @@index([userId])
}

model StaffMember {
  id                String    @id @default(cuid())
  userId            String
  name              String
  phone             String?
  pin               String?
  role              String?
  customRoleId      String?
  email             String?
  passwordHash      String?
  accessRole        String    @default("NONE")
  inviteToken       String?   @unique
  inviteExpiresAt   DateTime?
  lastLoginAt       DateTime?
  payType           String    @default("monthly")
  payAmount         Int       @default(0)
  /// Kobo sibling — Phase 3 of the kobo migration.
  payAmountKobo     Int       @default(0)
  startDate         DateTime?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  nextOfKinName     String?
  nextOfKinPhone    String?
  notes             String?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole    CustomRole?    @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  staffPayments StaffPayment[]
  tasks         Task[]

  @@unique([userId, email])
  @@index([userId, status])
  @@index([email])
  @@index([customRoleId])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  staffId   String
  date      DateTime
  status    String   @default("present")
  note      String?
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([userId, date])
}

model StaffPayment {
  id          String    @id @default(cuid())
  userId      String
  staffId     String
  kind        String
  amount      Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo  Int       @default(0)
  periodStart DateTime?
  periodEnd   DateTime?
  note        String?
  paidAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([userId, paidAt])
  @@index([staffId, paidAt])
}

// ---------- TASK MANAGEMENT ----------

model Task {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  assignedToId    String?
  customerId      String?
  priority        String    @default("normal")
  status          String    @default("todo")
  dueDate         DateTime?
  completedAt     DateTime?
  completedByKind String?
  completedById   String?
  completionNote  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo StaffMember? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([assignedToId, status])
}

// ---------- CHECKLISTS ----------

model Checklist {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  category    String   @default("custom")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ChecklistItem[]
  runs  ChecklistRun[]

  @@index([userId])
}

model ChecklistItem {
  id          String @id @default(cuid())
  checklistId String
  label       String
  sortOrder   Int    @default(0)

  checklist Checklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  results   ChecklistResult[]

  @@index([checklistId])
}

model ChecklistRun {
  id          String    @id @default(cuid())
  userId      String
  checklistId String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist Checklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  results   ChecklistResult[]

  @@index([userId, checklistId])
}

model ChecklistResult {
  id        String    @id @default(cuid())
  runId     String
  itemId    String
  checked   Boolean   @default(false)
  note      String?
  checkedAt DateTime?

  run  ChecklistRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------- RECEIPTS ----------

model Receipt {
  id            String    @id @default(cuid())
  userId        String
  customerId    String?
  paymentId     String?   @unique
  debtId        String?   @unique
  receiptNumber String    @unique
  pdfUrl        String?
  status        String    @default("GENERATED")
  emailedTo     String?
  emailedAt     DateTime?

  /// Outstanding balance when this receipt was generated (partial payment).
  /// null = full payment; >0 means the receipt should display "Balance: X".
  balanceRemaining     Int?
  /// Kobo sibling — Phase 3 of the kobo migration.
  balanceRemainingKobo Int?
  /// Where this receipt originated. "MANUAL" | "PAYSTACK" | "PROMISE" | "INSTALLMENT" | "DEBT" | "CATALOG"
  source               String @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  feedbacks Feedback[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, source])
}

// ---------- ADMIN ----------

model AdminNote {
  id           String   @id @default(cuid())
  adminUserId  String
  targetUserId String
  note         String
  createdAt    DateTime @default(now())

  author User @relation("AdminNoteAuthor", fields: [adminUserId], references: [id], onDelete: Cascade)
  target User @relation("AdminNoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
}

/// Per-user manual overrides that supersede plan-derived feature limits and
/// flags. Used by ops to comp specific features or quotas without touching
/// the user's plan tier. The service layer parses `overrides` (JSON text
/// shaped like Partial<Limits>) and merges it on top of `limitsFor(plan)`.
model UserOverride {
  id           String   @id @default(cuid())
  userId       String   @unique
  /// JSON blob shaped like Partial<Limits>. Each key, when present,
  /// overrides the plan-derived value for that user. Stored as text for
  /// schema simplicity; the service layer parses it.
  overrides    String
  /// Optional admin-set discount (kobo) applied at next renewal. Negative
  /// values = credit, positive = surcharge. Capped to the next-renewal
  /// amount in the billing flow.
  discountKobo Int?
  /// Optional reason for audit context.
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------- CATALOG (Sell) ----------

/// Public catalog activity log. Used to track WhatsApp order clicks
/// without creating Payment rows (we don't auto-pend orders — see plan).
/// ipHash is sha256(ip + YYYY-MM-DD + AUTH_SECRET): rotates daily, prevents linkability.
model CatalogEvent {
  id            String   @id @default(cuid())
  userId        String
  productId     String?
  /// "VIEW" | "WHATSAPP_ORDER"
  type          String
  ipHash        String?
  userAgent     String?
  referrer      String?
  /// Optional shopper details captured on the order form (free text, length-capped).
  customerName  String?
  customerPhone String?
  note          String?
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId])
  @@index([userId, type])
}

/// Yupoo-style product album. A grouping of catalog products that the seller
/// can share via a single link, optionally protected by a passcode that
/// they share separately (e.g. on WhatsApp).
model Album {
  id               String   @id @default(cuid())
  userId           String
  /// Per-user unique URL slug. e.g. "summer-2026" → /store/<seller>/album/summer-2026
  slug             String
  title            String
  description      String?
  /// URL of a cover image. When null, the public page falls back to the
  /// first product's first image.
  coverImageUrl    String?
  /// When true, the public album page shows a passcode prompt before the
  /// product grid. The unlock API issues a signed httpOnly cookie.
  passcodeRequired Boolean  @default(false)
  /// bcrypt hash of the passcode. null when passcodeRequired=false.
  passcodeHash     String?
  /// Whether the album is visible on /store/<slug> at all.
  isPublished      Boolean  @default(true)
  /// Display order on the storefront homepage. Lower = first.
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products AlbumProduct[]

  @@unique([userId, slug])
  @@index([userId, isPublished])
}

/// Many-to-many join. Position lets the seller drag-reorder products inside
/// an album without affecting their order in other albums.
model AlbumProduct {
  albumId   String
  productId String
  position  Int      @default(0)
  addedAt   DateTime @default(now())

  album   Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([albumId, productId])
  @@index([albumId, position])
  @@index([productId])
}

// ---------- BILLING ----------

model PaymentAttempt {
  id                String   @id @default(cuid())
  userId            String
  targetPlan        String
  amount            Int
  currency          String   @default("NGN")
  paystackReference String   @unique
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([userId, createdAt])
  @@index([status])
}

model BillingEvent {
  id              String   @id @default(cuid())
  paystackEventId String   @unique
  eventType       String
  payloadJson     String
  processedAt     DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ---------- SUPPORT & TICKETS ----------

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String
  subject     String
  description String
  status      String    @default("open")
  priority    String    @default("medium")
  assignedTo  String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User          @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?         @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  replies  TicketReply[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([assignedTo])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ---------- NOTIFICATIONS ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info")
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ---------- REFUNDS ----------

model Refund {
  id               String    @id @default(cuid())
  userId           String
  paymentAttemptId String?
  amount           Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo       Int       @default(0)
  currency         String    @default("NGN")
  status           String    @default("pending")
  reason           String
  adminNote        String?
  processedBy      String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User            @relation("UserRefunds", fields: [userId], references: [id], onDelete: Restrict)
  processor      User?           @relation("ProcessedRefunds", fields: [processedBy], references: [id], onDelete: SetNull)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

// ---------- AUDIT LOGGING ----------

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  admin User @relation("AuditLogAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([action])
  @@index([targetId])
}

// ---------- PAYLINK (Payment Requests) ----------

model PaymentRequest {
  id             String    @id @default(cuid())
  userId         String
  customerId     String?
  token          String    @unique @default(cuid())
  linkNumber     String    @unique
  customerName   String
  customerPhone  String
  amount         Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo     Int       @default(0)
  description    String?
  status         String    @default("pending")
  viewedAt       DateTime?
  claimedAt      DateTime?
  confirmedAt    DateTime?
  whatsappSentAt DateTime?
  emailSentAt    DateTime?
  customerEmail  String?
  debtId         String?
  expiresAt      DateTime?

  /// Provider payment tracking (for auto-confirmed paylinks)
  provider          String?
  externalRef       String?
  /// PENDING | SUCCESS | FAILED
  paymentStatus     String?
  webhookVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([externalRef])
}

// ---------- PHASE 2: AUTO FOLLOW-UP REMINDERS ----------

/// A rule that defines automatic reminder behavior for a specific debt.
/// The cron job (`/api/cron/run-reminders`) evaluates all active rules and
/// creates ReminderLog entries + surfaces WhatsApp deep-links.
model ReminderRule {
  id           String   @id @default(cuid())
  userId       String
  debtId       String
  /// "gentle" | "firm" | "final" — escalation tone
  tone         String   @default("gentle")
  /// Number of days between auto-reminders
  intervalDays Int      @default(3)
  /// Maximum number of reminders before the rule auto-disables
  maxReminders Int      @default(5)
  /// How many reminders have been sent under this rule
  sentCount    Int      @default(0)
  /// When the next reminder should fire
  nextFireAt   DateTime
  /// Whether this rule is active
  enabled      Boolean  @default(true)
  /// "whatsapp" | "email" | "both"
  channel      String   @default("whatsapp")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  logs ReminderLog[]

  @@index([userId, enabled, nextFireAt])
  @@index([debtId])
}

/// Log of every reminder sent (for audit & analytics).
model ReminderLog {
  id            String   @id @default(cuid())
  userId        String
  ruleId        String?
  debtId        String?
  customerId    String?
  customerName  String
  customerPhone String
  amount        Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo    Int      @default(0)
  /// "whatsapp" | "email"
  channel       String
  /// "gentle" | "firm" | "final"
  tone          String   @default("gentle")
  /// WhatsApp deep link or email ID for tracking
  deliveryRef   String?
  createdAt     DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule ReminderRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ruleId])
}

// ---------- PHASE 4: COLLECTION PERFORMANCE SCORE ----------

/// Snapshot of a seller's collection performance, computed daily by cron.
/// Powers the "Collection Score" widget on the dashboard.
model CollectionScore {
  id                    String   @id @default(cuid())
  userId                String
  /// 0-100 overall collection effectiveness score
  score                 Int      @default(50)
  /// Percentage of debts collected on time (0-100)
  onTimeRate            Float    @default(0)
  /// Average days to collect across all debts
  avgCollectionDays     Float    @default(0)
  /// Total amount collected in the scoring window
  collectedAmount       Int      @default(0)
  /// Total amount outstanding
  outstandingAmount     Int      @default(0)
  /// Kobo siblings — Phase 3 of the kobo migration.
  collectedAmountKobo   Int      @default(0)
  outstandingAmountKobo Int      @default(0)
  /// Number of active follow-up rules
  activeReminders       Int      @default(0)
  /// Scoring period start
  periodStart           DateTime
  /// Scoring period end
  periodEnd             DateTime
  createdAt             DateTime @default(now())

  @@unique([userId, periodStart])
  @@index([userId, createdAt])
}

// ---------- BLOG ----------

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @default("")
  content         String
  coverImage      String?
  author          String
  status          String    @default("draft")
  category        String    @default("general")
  tags            String    @default("")
  /// SEO meta description (auto-filled from excerpt if blank)
  metaDescription String?
  /// Open Graph title override
  ogTitle         String?
  /// Open Graph image override (falls back to coverImage)
  ogImage         String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([slug])
}

// ---------- ADMIN STAFF (Platform RBAC) ----------

model AdminStaff {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  /// SUPER_ADMIN | BLOG_MANAGER | BILLING_MANAGER | SUPPORT_AGENT | PROPERTY_MANAGER | REPORTS_VIEWER
  adminRole       String
  status          String    @default("invited") // invited | active | suspended | revoked
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  /// The admin User.id who created this staff
  createdById     String
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User @relation("AdminStaffCreator", fields: [createdById], references: [id])

  @@index([adminRole])
  @@index([status])
  @@index([email])
}

// ---------- PROMISE TO PAY ----------

/// A structured payment commitment sent to a debtor. Public at /promise/[publicToken].
model PromiseToPay {
  id                   String    @id @default(cuid())
  userId               String
  customerId           String?
  debtId               String?
  paymentRequestId     String?
  customerNameSnapshot String
  phoneSnapshot        String
  originalAmount       Int
  remainingAmount      Int
  /// Kobo siblings — Phase 3 of the kobo migration.
  originalAmountKobo   Int       @default(0)
  remainingAmountKobo  Int       @default(0)
  /// OPEN | PARTIALLY_PAID | PROMISED | PAID | BROKEN | CANCELLED | EXPIRED
  status               String    @default("OPEN")
  publicToken          String    @unique @default(cuid())
  publicUrl            String?
  note                 String?
  lastActionAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  commitments PromiseCommitment[]
  payments    PromisePayment[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([publicToken])
  @@index([customerId])
  @@index([debtId])
}

/// A commitment made by the debtor on a PromiseToPay.
model PromiseCommitment {
  id              String    @id @default(cuid())
  promiseToPayId  String
  /// PAY_NOW | PAY_PART | PAY_ON_DATE
  commitmentType  String
  committedAmount Int?
  promisedDate    DateTime?
  message         String?
  createdAt       DateTime  @default(now())

  promiseToPay PromiseToPay @relation(fields: [promiseToPayId], references: [id], onDelete: Cascade)

  @@index([promiseToPayId])
}

/// A payment made against a PromiseToPay, tracked through a payment provider.
model PromisePayment {
  id                    String    @id @default(cuid())
  promiseToPayId        String
  /// PAYSTACK | FLUTTERWAVE
  provider              String?
  providerReference     String?
  providerTransactionId String?
  amount                Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo            Int       @default(0)
  /// PENDING | SUCCESS | FAILED
  status                String    @default("PENDING")
  verifiedAt            DateTime?
  paidAt                DateTime?
  rawWebhookStored      Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  promiseToPay PromiseToPay @relation(fields: [promiseToPayId], references: [id], onDelete: Cascade)

  @@index([promiseToPayId])
  @@index([providerReference])
  @@index([providerTransactionId])
  @@index([status])
}

/// Installment plan for recurring auto-debit via Paystack authorization.
model InstallmentPlan {
  id                            String    @id @default(cuid())
  userId                        String
  promiseToPayId                String?
  debtId                        String?
  customerId                    String?
  customerNameSnapshot          String
  phoneSnapshot                 String
  totalAmount                   Int
  remainingAmount               Int
  initialAmount                 Int? // first payment amount (may differ from recurring)
  recurringAmount               Int
  /// Kobo siblings — Phase 3 of the kobo migration.
  totalAmountKobo               Int       @default(0)
  remainingAmountKobo           Int       @default(0)
  initialAmountKobo             Int?
  recurringAmountKobo           Int       @default(0)
  /// DAILY | WEEKLY | BIWEEKLY | MONTHLY
  interval                      String    @default("MONTHLY")
  totalInstallments             Int? // null = charge until cleared
  completedInstallments         Int       @default(0)
  nextChargeAt                  DateTime?
  lastChargedAt                 DateTime?
  /// ACTIVE | COMPLETED | FAILED | CANCELLED | PAUSED
  status                        String    @default("ACTIVE")
  paystackAuthorizationCode     String?
  paystackAuthorizationReusable Boolean   @default(false)
  paystackCustomerCode          String?
  paystackEmail                 String?
  failedAttempts                Int       @default(0)
  lastFailureReason             String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  charges InstallmentCharge[]

  @@index([userId, status])
  @@index([status, nextChargeAt])
  @@index([promiseToPayId])
  @@index([debtId])
  @@index([customerId])
}

/// Individual charge attempt within an installment plan.
model InstallmentCharge {
  id                    String    @id @default(cuid())
  installmentPlanId     String
  userId                String
  amount                Int
  /// Kobo sibling — Phase 3 of the kobo migration.
  amountKobo            Int       @default(0)
  reference             String    @unique
  /// PENDING | SUCCESS | FAILED | VERIFICATION_PENDING
  status                String    @default("PENDING")
  providerTransactionId String?
  failureReason         String?
  paymentId             String? // linked Payment record after success
  receiptId             String? // linked Receipt record after success
  verifiedAt            DateTime?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  installmentPlan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@index([installmentPlanId])
  @@index([reference])
  @@index([providerTransactionId])
  @@index([status])
  @@index([createdAt])
}

/// Durable log for all incoming payment webhooks — audit and replay.
model WebhookEventLog {
  id                 String    @id @default(cuid())
  /// PAYSTACK | FLUTTERWAVE
  provider           String
  eventType          String
  reference          String?
  transactionId      String?
  payload            String
  /// RECEIVED | VERIFIED | REJECTED | DUPLICATE | FAILED
  verificationStatus String    @default("RECEIVED")
  processedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([provider, reference])
  @@index([provider, transactionId])
  @@index([verificationStatus])
  @@index([createdAt])
}

// ---------- SERVICE CHECK (customer feedback) ----------

/// Customer feedback collected after a receipt, payment, or invoice. Public
/// at /feedback/[publicToken]. Idempotent per source-document so a single
/// transaction never gets two feedback links.
model Feedback {
  id             String    @id @default(cuid())
  userId         String
  customerId     String?
  /// The PRD calls this "transactionId"; in CashTraka the closest concept is
  /// a Payment row, so the field is named paymentId and references Payment.
  paymentId      String?
  receiptId      String?
  invoiceId      String?
  /// 'VERY_HAPPY' | 'HAPPY' | 'UNHAPPY' | 'VERY_UNHAPPY'. Stored as String to
  /// match the codebase convention (see Invoice.status).
  rating         String
  /// 'DELAY' | 'WRONG_ITEM' | 'POOR_SERVICE' | 'PAYMENT_ISSUE' | 'OTHER'.
  /// Required when rating is negative; the API enforces this.
  reason         String?
  comment        String?
  /// 'RECEIPT' | 'INVOICE' | 'PAYMENT' | 'TRANSACTION' | 'MANUAL'.
  source         String
  publicToken    String    @unique
  /// Set when the customer submits the rating. null while pending.
  submittedAt    DateTime?
  /// Computed at creation time from User.feedbackLinkExpiryDays. null = never.
  expiresAt      DateTime?
  /// Snapshot helper: true when rating is UNHAPPY or VERY_UNHAPPY.
  isNegative     Boolean   @default(false)
  isResolved     Boolean   @default(false)
  resolvedAt     DateTime?
  /// Free-text note about how the seller followed up.
  responseAction String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  receipt  Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([customerId])
  @@index([receiptId])
  @@index([paymentId])
  @@index([rating])
  @@index([userId, isNegative])
  @@index([userId, isResolved])
}

/// VAT return aggregate, produced by the Tax+ tier's auto VAT return
/// generator. Each row covers one period (monthly or quarterly) and stores
/// the pre-computed totals so the seller can hand the PDF + CSV to their
/// accountant or the FIRS portal directly.
model VatReturn {
  id            String    @id @default(cuid())
  userId        String
  /// "MONTHLY" or "QUARTERLY"
  period        String    @default("QUARTERLY")
  /// First day of the period (UTC), e.g. 2025-04-01 for Q2 2025.
  periodStart   DateTime
  /// Last day of the period (UTC), inclusive, e.g. 2025-06-30.
  periodEnd     DateTime
  /// Sum of vatApplied invoice tax in kobo, output VAT.
  outputVatKobo Int       @default(0)
  /// Sum of expense vatPaid in kobo, input VAT.
  inputVatKobo  Int       @default(0)
  /// outputVat - inputVat. Can be negative (refund position).
  netVatKobo    Int       @default(0)
  /// Counts that produced the totals, useful for the accountant.
  invoiceCount  Int       @default(0)
  expenseCount  Int       @default(0)
  /// Locked when the seller has filed it. Locked rows are read-only.
  status        String    @default("DRAFT")
  /// "DRAFT" | "FILED" | "PAID"
  filedAt       DateTime?
  filedBy       String?
  /// FIRS reference if the seller pasted one after filing manually.
  firsReference String?
  pdfUrl        String?
  csvUrl        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId, status])
  @@index([userId, periodStart])
}

// ---------- TAX+ TIER: BANK SYNC (MONO) ----------

/// A bank account linked via Mono Connect (Tax+ tier). One row per account
/// the seller has authorised. Pulled transactions land in BankTransaction.
/// The Mono integration ships behind a feature flag, the row shape exists
/// now so partnership wiring can plug in without further schema work.
model LinkedBankAccount {
  id            String    @id @default(cuid())
  userId        String
  /// Provider key, currently always "MONO" but reserved for future
  /// providers (Okra, Stitch, etc.).
  provider      String    @default("MONO")
  /// Provider-side account id. For Mono this is the account uuid.
  externalId    String    @unique
  bankName      String
  accountName   String
  accountNumber String
  /// Last successful sync. Null when never synced.
  lastSyncAt    DateTime?
  /// "ACTIVE" | "DISCONNECTED" | "ERROR"
  status        String    @default("ACTIVE")
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([userId, status])
}

/// One bank transaction pulled from the linked account. Each row is unique
/// per provider externalId. matchStatus tracks reconciliation against an
/// Invoice or Payment row.
model BankTransaction {
  id               String   @id @default(cuid())
  accountId        String
  externalId       String   @unique
  /// "CREDIT" or "DEBIT"
  direction        String
  amountKobo       Int
  description      String?
  reference        String?
  occurredAt       DateTime
  /// "UNMATCHED" | "MATCHED" | "IGNORED"
  matchStatus      String   @default("UNMATCHED")
  matchedInvoiceId String?
  matchedPaymentId String?
  createdAt        DateTime @default(now())

  account LinkedBankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([accountId, matchStatus])
  @@index([matchedInvoiceId])
}

// ---------- TAX+ TIER: VIRTUAL ACCOUNT PER INVOICE ----------

/// A unique 10-digit NUBAN minted via a partner bank (Wema / Sterling /
/// Providus) and tied to one invoice. Customers transfer to this account
/// and the partner webhook (future work) reconciles automatically.
model VirtualAccount {
  id            String    @id @default(cuid())
  userId        String
  invoiceId     String?   @unique
  /// Provider: "WEMA" | "STERLING" | "PROVIDUS"
  provider      String
  /// Provider-side reference / account id
  externalId    String    @unique
  /// The 10-digit NUBAN to print on the invoice
  accountNumber String
  accountName   String
  bankName      String
  /// "ACTIVE" | "EXPIRED" | "RECONCILED"
  status        String    @default("ACTIVE")
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────
// OPERATIONAL PLANNING — small-batch operations
// Pivot: orders → production → materials → inventory → purchases.
// All models below are additive. They do NOT modify existing tables.
// Money is stored as Int kobo. Status fields are String literals
// (matching the existing convention — no native enums).
// Soft-delete = deletedAt DateTime?. Tenant-scoped via userId.
// ─────────────────────────────────────────────────────────────────

/// A vendor that supplies raw materials. Distinct from Customer.
model Supplier {
  id                     String    @id @default(cuid())
  userId                 String
  name                   String
  contactPerson          String?
  phone                  String?
  /// Optional dedicated WhatsApp number — falls back to `phone` when null.
  whatsappNumber         String?
  email                  String?
  address                String?
  /// Free-form classification for filter UI: e.g. "Packaging", "Ingredients".
  supplierCategory       String?
  /// Free-form list of materials this supplier provides.
  materialsSupplied      String?
  /// Net payment terms, e.g. "Net 30", "COD", "50% deposit".
  paymentTerms           String?
  /// Typical lead time in days from PO sent → goods received.
  /// Used to default new PurchaseOrder.expectedAt.
  leadTimeDays           Int?
  /// Minimum order quantity the supplier accepts.
  minimumOrderQuantity   Int?
  /// "DELIVERY" | "PICKUP" | "THIRD_PARTY"
  deliveryMethod         String?
  /// Stamped on every PurchaseOrder receive — drives "supplier last seen" UI.
  lastPurchaseAt         DateTime?
  /// Total kobo amount of the most recent received PO.
  lastPurchaseAmountKobo Int?
  /// Rolling 0–100 on-time-delivery rating, recomputed after each PO receive.
  onTimeDeliveryRating   Int?
  /// Rolling 0–100 quality rating (1 − rejection rate × 100), recomputed
  /// after each PO receive.
  qualityRating          Int?
  /// "ACTIVE" | "INACTIVE" | "BLACKLISTED"
  status                 String    @default("ACTIVE")
  notes                  String?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawMaterials   RawMaterial[]
  purchaseOrders PurchaseOrder[]

  @@index([userId, deletedAt])
  @@index([userId, name])
  @@index([userId, status])
}

/// A raw material consumed during production. Distinct from Product
/// (Product = finished good with selling price; RawMaterial = input).
model RawMaterial {
  id                       String    @id @default(cuid())
  userId                   String
  name                     String
  sku                      String?
  /// Free-form classification (e.g. "Oils", "Bottles", "Labels").
  category                 String?
  /// "INGREDIENT" | "PACKAGING" | "FABRIC" | "COMPONENT" | "CHEMICAL" | "CONSUMABLE" | "OTHER"
  materialType             String?
  /// Unit of measure label, e.g. "kg" | "g" | "l" | "ml" | "unit" | "m" | "pack".
  /// Stock is stored as an Int in this single base unit; no multi-unit math.
  unit                     String    @default("unit")
  stock                    Int       @default(0)
  reorderLevel             Int       @default(0)
  /// Optional safety-stock buffer below reorderLevel — when stock hits
  /// safetyStock the alert is upgraded from "low" to "critical".
  safetyStock              Int?
  /// Minimum quantity to order when reordering from the preferred supplier.
  minimumPurchaseQuantity  Int?
  /// Expected lead time in days from PO sent → goods received.
  expectedLeadTimeDays     Int?
  /// Supplier's own SKU for this material (printed on POs).
  supplierSku              String?
  /// Free-text storage location (e.g. "Shelf B3", "Cold room").
  storageLocation          String?
  /// Most recent batch / lot number received (helps reconcile receives).
  batchNumber              String?
  /// Last known cost per unit (kobo). Used by production-costing.
  unitCostKobo             Int       @default(0)
  /// Snapshot of the last received PO's unit cost — separate from the
  /// `unitCostKobo` rolling average so cost-trend reports can detect spikes.
  lastPurchasePriceKobo    Int?
  /// "APPROVED" | "PENDING_INSPECTION" | "REJECTED" | "EXPIRED"
  qualityStatus            String    @default("APPROVED")
  /// "ACTIVE" | "LOW_STOCK" | "OUT_OF_STOCK" | "DISCONTINUED" — computed and
  /// cached on writes for fast filter UIs.
  status                   String    @default("ACTIVE")
  supplierId               String?
  /// Optional expiry hint for the nearest-expiring batch.
  expiresAt                DateTime?
  notes                    String?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  recipeItems            RecipeItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  recipeSubstitutes      RecipeItem[] @relation("RecipeItemSubstitute")
  shortageAlerts         MaterialShortageAlert[]

  @@index([userId, deletedAt])
  @@index([userId, supplierId])
  @@index([userId, expiresAt])
  @@index([userId, status])
  @@index([userId, materialType])
}

/// Recipe (a.k.a. "Materials Needed") for one finished Product.
/// Simple single-level BOM — no phantom or sub-assembly recipes.
model Recipe {
  id                   String    @id @default(cuid())
  userId               String
  productId            String    @unique
  /// Display name for the recipe (defaults to the product name when blank).
  recipeName           String?
  /// Manually-bumped version counter. Helps audit who changed what when.
  versionNumber        Int       @default(1)
  /// "DRAFT" | "ACTIVE" | "ARCHIVED" — only ACTIVE is consumed by production
  /// material checks; DRAFT lets you stage a change without disrupting runs.
  status               String    @default("ACTIVE")
  /// One batch of this recipe yields N units of the product.
  yieldQty             Int       @default(1)
  /// Output unit label printed on production paperwork ("bottles", "pieces").
  outputUnit           String?
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@index([userId, deletedAt])
  @@index([userId, status])
}

/// One material line in a Recipe.
model RecipeItem {
  id                       String   @id @default(cuid())
  recipeId                 String
  materialId               String
  /// Quantity of the material consumed to produce one full yieldQty batch.
  quantity                 Int
  /// Wastage buffer applied during material-check (e.g. 5 = inflate required
  /// qty by 5% to account for spillage / trim). Stored as integer percent.
  wastageAllowancePercent  Int      @default(0)
  /// If true, `substituteMaterialId` may be consumed when the primary is short.
  substituteAllowed        Boolean  @default(false)
  /// Optional fallback material that can be swapped in if primary is short.
  substituteMaterialId     String?
  notes                    String?

  recipe              Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material            RawMaterial  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  substituteMaterial  RawMaterial? @relation("RecipeItemSubstitute", fields: [substituteMaterialId], references: [id], onDelete: SetNull)

  @@unique([recipeId, materialId])
  @@index([materialId])
}

/// Customer-facing order with a fulfilment lifecycle.
/// Distinct from the legacy `OrderConfirmation` (a sales doc derived from
/// accepted offers). `orderConfirmationId` is an optional soft bridge.
model CustomerOrder {
  id                  String    @id @default(cuid())
  userId              String
  customerId          String?
  /// Snapshot for resilience against customer rename/delete.
  customerName        String
  customerPhone       String?
  /// Human-readable e.g. "CO-00042".
  orderNumber         String    @unique
  /// "NEW" | "CONFIRMED" | "IN_PRODUCTION" | "READY" | "DELIVERED" | "CANCELLED"
  status              String    @default("NEW")
  /// "UNPAID" | "PART_PAID" | "PAID" — distinct from the production lifecycle.
  paymentStatus       String    @default("UNPAID")
  /// "LOW" | "NORMAL" | "HIGH" | "URGENT" — drives dashboard sort.
  priority            String    @default("NORMAL")
  /// "WHATSAPP" | "WALK_IN" | "INSTAGRAM" | "WEBSITE" | "REFERRAL" | "OTHER"
  source              String?
  /// "PICKUP" | "DELIVERY" | "DISPATCH" | "THIRD_PARTY"
  deliveryMethod      String?
  /// Free-text address for DELIVERY / DISPATCH.
  deliveryAddress     String?
  /// Free-text dispatch note shown to courier / packer.
  deliveryNote        String?
  /// User ID of the staff member responsible for fulfilment.
  assignedTo          String?
  /// Internal note hidden from customer-facing documents.
  internalNote        String?
  dueAt               DateTime?
  totalKobo           Int       @default(0)
  notes               String?
  /// Optional bridge to legacy `OrderConfirmation` if the user converted one.
  orderConfirmationId String?
  /// Generated production order — nullable until production is planned.
  productionOrderId   String?   @unique
  /// Generated invoice — nullable until invoiced.
  invoiceId           String?   @unique
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderConfirmation OrderConfirmation?  @relation(fields: [orderConfirmationId], references: [id], onDelete: SetNull)
  productionOrder   ProductionOrder?    @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items             CustomerOrderItem[]

  @@index([userId, status, createdAt])
  @@index([userId, customerId, createdAt])
  @@index([userId, dueAt])
  @@index([userId, deletedAt])
  @@index([userId, paymentStatus])
  @@index([userId, priority, dueAt])
}

/// Line item on a CustomerOrder.
model CustomerOrderItem {
  id              String  @id @default(cuid())
  customerOrderId String
  productId       String?
  description     String
  quantity        Int     @default(1)
  unitPriceKobo   Int     @default(0)
  /// Per-line discount in kobo. Reduces `totalKobo`.
  discountKobo    Int     @default(0)
  totalKobo       Int     @default(0)
  /// Per-line note carried onto the production / packing slip.
  lineNotes       String?

  customerOrder CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([customerOrderId])
  @@index([productId])
}

/// Internal production run for one or more finished products.
/// Lifecycle: PLANNED → MATERIALS_NEEDED → READY_TO_PRODUCE → IN_PRODUCTION
///            → COMPLETED (or → DELAYED / CANCELLED from any state).
model ProductionOrder {
  id                 String    @id @default(cuid())
  userId             String
  /// Human-readable e.g. "PRD-00042".
  productionNumber   String    @unique
  /// Optional display title (defaults to product name when blank).
  title              String?
  /// "PLANNED" | "MATERIALS_NEEDED" | "READY_TO_PRODUCE" | "IN_PRODUCTION" |
  /// "COMPLETED" | "DELAYED" | "CANCELLED"
  status             String    @default("PLANNED")
  /// "LOW" | "NORMAL" | "HIGH" | "URGENT" — drives Kanban sort.
  priority           String    @default("NORMAL")
  /// User ID of the staff member responsible for executing the run.
  assignedTo         String?
  plannedStartAt     DateTime?
  plannedEndAt       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  /// QC: total quantity actually produced across all items in this run.
  quantityProduced   Int?
  /// QC: quantity rejected during inspection (broken / off-spec).
  quantityDamaged    Int?
  /// QC: quantity that passed inspection and moved to finished-goods stock.
  /// Should equal `quantityProduced - quantityDamaged` when both are set.
  quantityAccepted   Int?
  notes              String?
  /// Batch / lot identifier printed on every unit of this run. Set when
  /// the run starts. Required for NAFDAC traceability on food + cosmetics.
  /// Free-text so businesses keep whatever lot scheme they use today.
  batchNumber        String?
  /// Manufacture date stamped on every unit. Defaults to `startedAt`
  /// when not overridden.
  manufacturedAt     DateTime?
  /// Earliest expiry stamped on every unit of this run. For shelf-stable
  /// goods (soap, fabric) leave null.
  expiresAt          DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerOrder  CustomerOrder?
  items          ProductionOrderItem[]
  shortageAlerts MaterialShortageAlert[]

  @@index([userId, status, createdAt])
  @@index([userId, plannedEndAt])
  @@index([userId, deletedAt])
  @@index([userId, batchNumber])
  @@index([userId, expiresAt])
  @@index([userId, priority, plannedEndAt])
}

/// One product line in a ProductionOrder.
model ProductionOrderItem {
  id                   String @id @default(cuid())
  productionOrderId    String
  productId            String
  quantity             Int
  /// Snapshot of per-unit material cost (kobo) computed when status flips to
  /// COMPLETED. Null until then.
  unitCostKoboSnapshot Int?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, productId])
  @@index([productId])
}

/// Outbound purchase order sent to a supplier.
/// Lifecycle: DRAFT → SENT → ORDERED → PARTIALLY_RECEIVED → RECEIVED
///            (or → CANCELLED from any state).
model PurchaseOrder {
  id              String    @id @default(cuid())
  userId          String
  supplierId      String
  /// Human-readable e.g. "PO-00042".
  poNumber        String    @unique
  /// "DRAFT" | "SENT" | "ORDERED" | "PARTIALLY_RECEIVED" | "RECEIVED" | "CANCELLED"
  status          String    @default("DRAFT")
  /// "UNPAID" | "PART_PAID" | "PAID"
  paymentStatus   String    @default("UNPAID")
  /// Kobo amount already paid to the supplier (rolled up from payments).
  amountPaidKobo  Int       @default(0)
  /// "LOW" | "NORMAL" | "HIGH" | "URGENT"
  priority        String    @default("NORMAL")
  expectedAt      DateTime? // When the supplier promised delivery.
  receivedAt      DateTime? // When all items were received.
  totalKobo       Int       @default(0)
  notes           String?
  pdfUrl          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseOrderItem[]

  @@index([userId, status, createdAt])
  @@index([userId, supplierId])
  @@index([userId, expectedAt])
  @@index([userId, deletedAt])
  @@index([userId, paymentStatus])
  @@index([userId, priority, expectedAt])
}

/// One material line in a PurchaseOrder.
model PurchaseOrderItem {
  id                  String    @id @default(cuid())
  purchaseOrderId     String
  materialId          String
  quantity            Int
  /// How many units have been received so far (drives partial-receipt flow).
  quantityReceived    Int       @default(0)
  /// How many units were rejected on inspection (damaged / off-spec).
  /// Stays on the doc for supplier-quality scoring; not added to stock.
  quantityRejected    Int       @default(0)
  unitCostKobo        Int       @default(0)
  totalKobo           Int       @default(0)
  /// Optional per-line expected delivery date when a PO spans multiple
  /// drop-off dates from the same supplier.
  expectedDeliveryAt  DateTime?
  /// "APPROVED" | "PENDING_INSPECTION" | "REJECTED" | null (not yet received)
  qualityStatus       String?
  /// Per-line note shown to the supplier and on the receive screen.
  lineNotes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      RawMaterial   @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, materialId])
  @@index([materialId])
}

/// Unified ledger of every stock change for both Products and RawMaterials.
/// Polymorphic via (itemType, itemId). Append-only — never updated.
/// `balanceAfter` is a denormalised snapshot of the item's stock at the
/// time of this movement, written by the inventory service for fast audit
/// queries. Use this table to reconstruct stock history for any item.
model StockMovement {
  id           String   @id @default(cuid())
  userId       String
  /// "PRODUCT" | "MATERIAL"
  itemType     String
  itemId       String
  /// Movement reason. One of:
  /// "PURCHASE_RECEIVE" | "PRODUCTION_CONSUME" | "PRODUCTION_PRODUCE" |
  /// "SALE" | "ADJUSTMENT" | "WRITE_OFF" | "RETURN"
  reason       String
  /// Positive for stock in, negative for stock out.
  delta        Int
  /// The item's new stock level after this movement was applied.
  balanceAfter Int
  /// Loose pointer to the source doc that caused this movement.
  /// e.g. refType="PURCHASE_ORDER" + refId=<PurchaseOrder.id>.
  refType      String?
  refId        String?
  notes        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, itemType, itemId, createdAt])
  @@index([userId, reason, createdAt])
  @@index([userId, refType, refId])
}

/// Recurring customer subscription — e.g. "monthly cleansing balm box for
/// Adaeze". A daily cron materialises the next CustomerOrder when due.
/// Pause / cancel from the customer detail page; we never delete history.
/// Recurring production template — "every Monday make 50 black soaps".
/// A daily cron compares `nextRunAt <= now`, spawns a ProductionOrder
/// from the template's items, then advances `nextRunAt` by `cadence`.
/// Tenant-scoped (userId). Items live in `ProductionTemplateItem`.
model ProductionTemplate {
  id          String    @id @default(cuid())
  userId      String
  /// Short label shown in the UI (e.g. "Weekly black soap batch").
  title       String
  /// "weekly" | "biweekly" | "monthly". Free-form so we can extend
  /// without a migration (same convention as CustomerOrderSubscription).
  cadence     String    @default("weekly")
  /// For weekly/biweekly cadences: 0=Sunday, 6=Saturday. Ignored for monthly.
  dayOfWeek   Int?
  /// For monthly cadence: 1-28. Ignored for weekly/biweekly. Capped at 28
  /// so February never silently skips.
  dayOfMonth  Int?
  /// Optional planned start offset (hours of day) — defaults to 9am.
  hourOfDay   Int       @default(9)
  /// When the next ProductionOrder should be spawned. Cron compares
  /// `nextRunAt <= now` and advances forward by `cadence` on success.
  nextRunAt   DateTime
  /// Last time the cron successfully spawned a ProductionOrder from this template.
  lastRunAt   DateTime?
  /// "active" | "paused" | "cancelled". Only `active` materialises.
  status      String    @default("active")
  /// Optional free-form note copied into the spawned ProductionOrder.
  notes       String?
  /// Soft-delete marker.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ProductionTemplateItem[]

  @@index([userId, status, nextRunAt])
  @@index([userId, deletedAt])
}

/// One product + quantity inside a ProductionTemplate. Quantity is the
/// per-run size (e.g. "50 bars per Monday run").
model ProductionTemplateItem {
  id         String @id @default(cuid())
  templateId String
  productId  String
  quantity   Int

  template ProductionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([templateId, productId])
  @@index([productId])
}

model CustomerOrderSubscription {
  id         String    @id @default(cuid())
  userId     String
  customerId String
  /// "weekly" | "biweekly" | "monthly" | "quarterly". Free-form so we
  /// can add new cadences without a migration.
  cadence    String
  /// Snapshot of the items at subscription time. JSON-encoded array of
  /// { productId?, description, quantity, unitPriceKobo }.
  itemsJson  String
  /// When the next CustomerOrder should be materialised. Cron compares
  /// `nextRunAt <= now` to decide. Updated forward by `cadence` on each
  /// successful run.
  nextRunAt  DateTime
  /// "active" | "paused" | "cancelled". Only `active` materialises.
  status     String    @default("active")
  /// Optional. After this date the subscription auto-completes.
  endsAt     DateTime?
  /// Last time the cron successfully spawned a CustomerOrder.
  lastRunAt  DateTime?
  /// Free-form note shown on the customer detail page.
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, status, nextRunAt])
  @@index([customerId])
}

/// Storage for regulatory + trust documents a business holds (NAFDAC
/// registration, CAC/RC certificate, FDA, SON product cert, TIN
/// certificate, organic cert, halal cert, etc.). Uploaded to Uploadcare
/// and the hosted URL stored here. Used to:
///   1. Surface expiry reminders in /notifications.
///   2. Generate a single share-link customers/distributors can verify.
///
/// Soft-delete via `deletedAt` since we never want to lose audit history
/// of "this product was once NAFDAC-certified".
model Certificate {
  id            String    @id @default(cuid())
  userId        String
  /// Document kind. Free-form short label, e.g.:
  ///   "NAFDAC" | "CAC" | "TIN" | "FDA" | "SON" | "HALAL" | "ORGANIC" | "OTHER"
  kind          String
  /// Optional product binding. Some certs (NAFDAC) are per-product;
  /// others (CAC) are business-wide. Null = applies to the whole business.
  productId     String?
  /// User-readable name displayed in the vault list.
  label         String
  /// Certificate number issued by the regulator (printed on the doc).
  certificateNumber String?
  /// Date the regulator issued the cert.
  issuedAt      DateTime?
  /// Date the cert expires. Drives the 30/60/90-day reminder cron.
  expiresAt     DateTime?
  /// Hosted Uploadcare URL. PDF or image.
  fileUrl       String
  /// MIME type detected at upload, e.g. application/pdf, image/jpeg.
  mimeType      String?
  /// Free-form notes the user wants to keep alongside the doc.
  notes         String?
  /// Public share token. When set, GET /c/[token] serves a read-only
  /// view of the cert (no auth required) so the business can prove
  /// authenticity to distributors and customers.
  publicToken   String?   @unique
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([userId, expiresAt])
  @@index([userId, productId])
}


/// A persisted material shortage detected when a ProductionOrder was
/// created (or refreshed) and the recipe demanded more material than
/// the tenant had in stock. Unlike the compute-on-the-fly shortages in
/// inventory.service, these rows survive past the production run and
/// drive the dashboard “Shortage alerts” card + the shortage-trend report.
///
/// Lifecycle: OPEN → RESOLVED (PO received OR substitute used OR stock
/// replenished by adjustment) or → IGNORED (operator dismissed).
model MaterialShortageAlert {
  id                  String   @id @default(cuid())
  userId              String
  productionOrderId   String
  materialId          String
  /// Required quantity from the recipe + wastage allowance.
  requiredQuantity    Int
  /// Stock available at the time the alert was generated.
  availableQuantity   Int
  /// Difference (required − available). Always positive on OPEN alerts.
  shortageQuantity    Int
  /// "LOW" | "MEDIUM" | "HIGH" | "CRITICAL" — derived from shortage size
  /// relative to safetyStock + lead-time pressure.
  severity            String   @default("MEDIUM")
  /// "BUY_MATERIAL" | "REDUCE_PRODUCTION" | "USE_SUBSTITUTE" | "DELAY_PRODUCTION"
  recommendedAction   String   @default("BUY_MATERIAL")
  /// Deadline by which the shortage must be resolved to hit the
  /// production order's planned end date.
  neededByDate        DateTime?
  /// "OPEN" | "RESOLVED" | "IGNORED"
  status              String   @default("OPEN")
  /// Free-form note (e.g. "covered by PO-00042", "substitute confirmed").
  resolutionNote      String?
  resolvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionOrder  ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material         RawMaterial      @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, materialId])
  @@index([userId, status, createdAt])
  @@index([userId, severity])
  @@index([userId, materialId])
}
