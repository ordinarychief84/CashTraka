# Copy this file to `.env.development`, `.env.staging`, `.env.production`
# and fill in the values for that environment. Anything prefixed
# EXPO_PUBLIC_ is bundled into the JS at build time and is therefore
# NOT a secret — never put server keys here.

EXPO_PUBLIC_API_BASE_URL=https://www.cashtraka.co
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_ENVIRONMENT=development
